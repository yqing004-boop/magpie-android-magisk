<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 模块版壳：内核在 Magisk 模块里，App 不 exec 任何东西。
         网络用于连本机 3425/3430 和调模型供应商。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 前台服务：让探测线程在用户点开 App 时保持高优先级 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 「忽略电池优化」按钮要把系统那个授权页拉起来 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 壳自更新（App 内下载 APK 后拉起安装器） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Shizuku：读模块的 data/ 配置、启停模块服务、写插件目录。
         普通 App 进不去 /data/adb/modules/，只能靠它。 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@drawable/ic_magpie_bird"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:roundIcon="@drawable/ic_magpie_bird"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Theme.Magpie">

        <!-- 主界面：原生绘制，直连本机 3425 的 HTTP 接口 -->
        <activity
            android:name=".NativeHome"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WebView 壳：插件安装、隐私脱敏、同步备份这些深度功能走网页 -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:label="@string/web_ui_title"
            android:parentActivityName=".NativeHome"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".NativeHome" />

        <!-- 探测服务：不启动内核，只轮询 3425 是否活着。
             没有 foregroundServiceType 是有意的：两参 startForeground()，
             targetSdk 28 下 Android 14 的类型要求不适用。 -->
        <service
            android:name=".GatewayService"
            android:exported="false" />

        <!-- 给系统安装器提供已下载 APK 的 content:// 读取通道 -->
        <provider
            android:name=".ApkFileProvider"
            android:authorities="com.magpie.module.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Shizuku 的 binder 接收器 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.magpie.module.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>
</manifest>
