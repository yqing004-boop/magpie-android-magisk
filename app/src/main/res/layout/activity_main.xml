<?xml version="1.0" encoding="utf-8"?>
<!-- magpie 网页界面：一整个 WebView，不加任何壳自己的顶栏 / 底栏 / 菜单。
     全部壳侧操作都在原生主界面（NativeHome）的 ⋮ 里做，这里只负责把
     magpie 自己的页面原样显出来。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/web_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 网关还没起来、或者挂了的时候顶上来。 -->
    <ScrollView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="36dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/status_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/status_starting"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:textSize="13sp" />

            <Button
                android:id="@+id/status_retry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:minWidth="160dp"
                android:text="@string/status_retry" />

            <Button
                android:id="@+id/status_show_log"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:minWidth="160dp"
                android:text="@string/status_show_log" />

            <Button
                android:id="@+id/status_settings"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="160dp"
                android:text="@string/status_settings" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
